# =============================================
# Dashboard Altezza — variáveis de ambiente
# Copie para .env e preencha os valores reais.
# NUNCA commite o .env com valores reais.
# =============================================

# Supabase — front (seguro expor)
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...

# Supabase — scripts locais (NUNCA no front)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# C2S — full load local (Supabase secret para a Edge Function)
C2S_TOKEN=seu_bearer_token_c2s

# Meta Marketing API — Supabase secret para a Edge Function
# Não precisa no .env local salvo que queira rodar backfill localmente
# META_ACCESS_TOKEN=EAABxxxxx
